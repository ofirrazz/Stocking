rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Public profile data must be readable without auth so the registration screen can
    // verify username uniqueness BEFORE the user is created in Firebase Auth.
    // Writes are still restricted to the document owner.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update: if isOwner(followerId);
        allow delete: if isOwner(followerId);
      }

      match /following/{followingId} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /portfolio/{symbol} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }

      match /favoriteSymbols/{symbol} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      // Author can update everything on their post.
      allow update: if signedIn() && resource.data.authorId == request.auth.uid;
      // Any signed-in user can update like counters and the comments counter
      // (the actual like is recorded inside `likedUserIds` which we restrict to this set).
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'likedUserIds', 'lastLikedBy', 'commentsCount']);

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
